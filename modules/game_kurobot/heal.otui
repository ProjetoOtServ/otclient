Panel
  layout:
    type: verticalBox
    spacing: 6
    fit-children: true

  // ── Auto Healing Helper ───────────────────────────────
  KuroBotSection
    anchors.left: parent.left
    anchors.right: parent.right

    KuroBotSectionTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text: Auto Healing Helper

    Panel
      id: healingGrid
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 110
      margin: 4
      background-color: alpha

      // Spell Healing — left column
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        text: Spell Healing
        color: #d4d4d8
        font: verdana-11px-rounded

      KuroBotIconSlot
        id: spell1Icon
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 4
        image-source: /images/icons/spell_healing_1.png

      KuroBotSpinBox
        id: spell1Percent
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 8

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4

      KuroBotIconSlot
        id: spell2Icon
        anchors.top: spell1Icon.bottom
        anchors.left: parent.left
        margin-top: 4
        image-source: /images/icons/spell_healing_2.png

      KuroBotSpinBox
        id: spell2Percent
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 8

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4

      // Potion Healing — right column
      Label
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 4
        text: Potion Healing
        color: #d4d4d8
        font: verdana-11px-rounded

      KuroBotIconSlot
        id: potion1Icon
        anchors.top: prev.bottom
        anchors.right: parent.right
        margin-top: 4
        image-source: /images/icons/potion_1.png

      KuroBotSpinBox
        id: potion1Percent
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: prev.left
        margin-right: 8

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: prev.left
        margin-right: 4

      KuroBotIconSlot
        id: potion2Icon
        anchors.top: potion1Icon.bottom
        anchors.right: parent.right
        margin-top: 4
        image-source: /images/icons/potion_2.png

      KuroBotSpinBox
        id: potion2Percent
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: prev.left
        margin-right: 8

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: prev.left
        margin-right: 4

  // ── Friend Healing Helper ─────────────────────────────
  KuroBotSection
    anchors.left: parent.left
    anchors.right: parent.right

    KuroBotSectionTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text: Friend Healing Helper

    Panel
      id: friendHealGrid
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 100
      margin: 4
      background-color: alpha

      // Left: friend selector list
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        text: Select a Friend
        color: #d4d4d8
        font: verdana-11px-rounded

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4

      KuroBotListPanel
        id: friendList
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 140
        margin-top: 4

      // Right: heal friend entries
      Label
        anchors.top: parent.top
        anchors.left: friendList.right
        margin-left: 10
        text: Heal Friend List
        color: #d4d4d8
        font: verdana-11px-rounded

      KuroBotAddButton
        id: addFriend1
        anchors.top: prev.bottom
        anchors.left: friendList.right
        margin-left: 10
        margin-top: 6

      KuroBotCheckBox
        id: enableSio1
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        text: Enable Sio

      KuroBotSpinBox
        id: sio1Percent
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 6

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4

      KuroBotAddButton
        id: addFriend2
        anchors.top: addFriend1.bottom
        anchors.left: friendList.right
        margin-left: 10
        margin-top: 4

      KuroBotCheckBox
        id: enableSio2
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        text: Enable Sio

      KuroBotSpinBox
        id: sio2Percent
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 6

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4

  // ── Exura Gran Sio Helper ─────────────────────────────
  KuroBotSection
    anchors.left: parent.left
    anchors.right: parent.right

    KuroBotSectionTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text: Exura Gran Sio Helper

    Panel
      id: exuraGrid
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 80
      margin: 4
      background-color: alpha

      Label
        anchors.top: parent.top
        anchors.left: parent.left
        text: Select a Friend
        color: #d4d4d8
        font: verdana-11px-rounded

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4

      KuroBotListPanel
        id: exuraFriendList
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 140
        margin-top: 4

      Label
        anchors.top: parent.top
        anchors.left: exuraFriendList.right
        margin-left: 10
        text: Heal Friend List
        color: #d4d4d8
        font: verdana-11px-rounded

      KuroBotAddButton
        id: addExura1
        anchors.top: prev.bottom
        anchors.left: exuraFriendList.right
        margin-left: 10
        margin-top: 6

      KuroBotCheckBox
        id: enableExura1
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 6
        text: Enable

      KuroBotSpinBox
        id: exura1Percent
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 6

      KuroBotInfoButton
        anchors.verticalCenter: prev.verticalCenter
        anchors.left: prev.right
        margin-left: 4

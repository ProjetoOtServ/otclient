// ============================================================
//  KuroBot Widget Styles
//  OTClient OTUI syntax: border-width + border-color (no CSS shorthand)
// ============================================================

KuroBotTabButton < UIButton
  size: 40 40
  image-smooth: false
  background-color: #27272a
  border-width: 1
  border-color: #3f3f46
  $checked:
    background-color: #3f3f46
    border-color: #52525b
  $hover !checked:
    background-color: #323235

KuroBotSection < Panel
  background-color: #1f1f22
  border-width: 1
  border-color: #52525b

KuroBotSectionTitle < Label
  background-color: #3a3a42
  border-width: 1
  border-color: #52525b
  color: #d4d4d8
  text-align: center
  font: verdana-11px-rounded
  height: 22
  padding-top: 3

KuroBotIconSlot < UIWidget
  size: 40 40
  background-color: #18181b
  border-width: 1
  border-color: #52525b
  image-smooth: false

KuroBotSpinBox < SpinBox
  background-color: #27272a
  color: #e4e4e7
  border-width: 1
  border-color: #52525b
  width: 64
  height: 22
  minimum: 0
  maximum: 100
  step: 1

KuroBotComboBox < ComboBox
  background-color: #27272a
  color: #e4e4e7
  border-width: 1
  border-color: #52525b
  height: 22

KuroBotButton < Button
  background-color: #3f3f46
  color: #e4e4e7
  border-width: 1
  border-color: #52525b
  height: 22
  font: verdana-11px-rounded
  padding: 2 8
  $hover:
    background-color: #52525b
  $pressed:
    background-color: #27272a

KuroBotPrimaryButton < Button
  background-color: #1d4ed8
  color: #ffffff
  border-width: 1
  border-color: #3b82f6
  height: 22
  font: verdana-11px-rounded
  padding: 2 8
  $hover:
    background-color: #2563eb

KuroBotCheckBox < CheckBox
  color: #e4e4e7
  font: verdana-11px-rounded
  $checked:
    color: #4ade80

KuroBotInfoButton < UIButton
  size: 20 20
  background-color: alpha
  border-width: 1
  border-color: #71717a
  color: #a1a1aa
  font: verdana-11px-rounded
  text: i
  text-align: center
  $hover:
    color: #e4e4e7
    border-color: #a1a1aa

KuroBotAddButton < Button
  size: 22 22
  background-color: #3f3f46
  border-width: 1
  border-color: #52525b
  color: #a1a1aa
  font: verdana-11px-rounded
  text: +
  text-align: center
  $hover:
    color: #e4e4e7

KuroBotListPanel < Panel
  background-color: #18181b
  border-width: 1
  border-color: #52525b

// KuroBot Main Window
// Architecture: MainWindow > tabBar Panel > contentArea (has anchors layout — no verticalBox on tab panels)
// Styles: kurobot_styles.otui (imported by kurobot.lua before displayUI)
// Icons: /images/icons/*.png (copied from mods/bot_helper/images/icons/)

MainWindow
  id: kurobotWindow
  !text: tr('KuroBot')
  size: 420 540
  @onEscape: modules.game_kurobot.toggle()

  // ── TAB BAR ──────────────────────────────────────────────
  Panel
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 44
    background-color: #3a3a42
    border-width: 1
    border-color: #52525b

    KuroBotTabButton
      id: tabBtnHealing
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      image-source: /images/icons/healing_icon.png
      @onClick: modules.game_kurobot.switchTab('healing')
      checked: true

    KuroBotTabButton
      id: tabBtnTools
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: /images/icons/tools_icon.png
      @onClick: modules.game_kurobot.switchTab('tools')

    KuroBotTabButton
      id: tabBtnSkillSet
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: /images/icons/mana_training.png
      @onClick: modules.game_kurobot.switchTab('skillset')

    KuroBotTabButton
      id: tabBtnHunting
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: /images/icons/rtcaster_icon.png
      @onClick: modules.game_kurobot.switchTab('hunting')

    Label
      id: tabLabel
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 12
      color: #e4e4e7
      font: verdana-11px-rounded
      text: Healing

  // ── SCROLLBAR ────────────────────────────────────────────
  VerticalScrollBar
    id: contentScrollBar
    anchors.top: tabBar.bottom
    anchors.bottom: footer.top
    anchors.right: parent.right
    margin-top: 2
    margin-bottom: 2
    step: 14
    pixels-scroll: true
    $!on:
      width: 0

  // ── CONTENT AREA ─────────────────────────────────────────
  ScrollablePanel
    id: contentArea
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: contentScrollBar.left
    anchors.bottom: footer.top
    vertical-scrollbar: contentScrollBar
    background-color: #27272a
    padding: 6

    // ╔══════════════════════════════════╗
    // ║           HEALING TAB            ║
    // ╚══════════════════════════════════╝
    Panel
      id: tabHealing
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 420
      visible: true

      // ── Auto Healing Helper ──────────────
      KuroBotSection
        id: sectionAutoHeal
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 148

        KuroBotSectionTitle
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          text: Auto Healing Helper

        // Left: Spell Healing
        Label
          id: spellColLabel
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 6
          margin-left: 4
          text: Spell Healing
          color: #d4d4d8
          font: verdana-11px-rounded

        KuroBotIconSlot
          id: spell1Icon
          anchors.top: spellColLabel.bottom
          anchors.left: parent.left
          margin-top: 4
          margin-left: 4
          image-source: /images/icons/spell_healing_1.png

        KuroBotSpinBox
          id: spell1Pct
          anchors.verticalCenter: spell1Icon.verticalCenter
          anchors.left: spell1Icon.right
          margin-left: 6
          value: 80

        KuroBotInfoButton
          anchors.verticalCenter: spell1Icon.verticalCenter
          anchors.left: prev.right
          margin-left: 4

        KuroBotIconSlot
          id: spell2Icon
          anchors.top: spell1Icon.bottom
          anchors.left: parent.left
          margin-top: 6
          margin-left: 4
          image-source: /images/icons/spell_healing_2.png

        KuroBotSpinBox
          id: spell2Pct
          anchors.verticalCenter: spell2Icon.verticalCenter
          anchors.left: spell2Icon.right
          margin-left: 6
          value: 99

        KuroBotInfoButton
          anchors.verticalCenter: spell2Icon.verticalCenter
          anchors.left: prev.right
          margin-left: 4

        // Right: Potion Healing
        Label
          id: potionColLabel
          anchors.top: spellColLabel.top
          anchors.right: parent.right
          margin-right: 4
          text: Potion Healing
          color: #d4d4d8
          font: verdana-11px-rounded

        KuroBotIconSlot
          id: potion1Icon
          anchors.top: potionColLabel.bottom
          anchors.right: parent.right
          margin-top: 4
          margin-right: 4
          image-source: /images/icons/potion_1.png

        KuroBotSpinBox
          id: potion1Pct
          anchors.verticalCenter: potion1Icon.verticalCenter
          anchors.right: potion1Icon.left
          margin-right: 6
          value: 60

        KuroBotInfoButton
          anchors.verticalCenter: potion1Icon.verticalCenter
          anchors.right: prev.left
          margin-right: 4

        KuroBotIconSlot
          id: potion2Icon
          anchors.top: potion1Icon.bottom
          anchors.right: parent.right
          margin-top: 6
          margin-right: 4
          image-source: /images/icons/potion_2.png

        KuroBotSpinBox
          id: potion2Pct
          anchors.verticalCenter: potion2Icon.verticalCenter
          anchors.right: potion2Icon.left
          margin-right: 6
          value: 30

        KuroBotInfoButton
          anchors.verticalCenter: potion2Icon.verticalCenter
          anchors.right: prev.left
          margin-right: 4

      // ── Friend Healing Helper ────────────
      KuroBotSection
        id: sectionFriendHeal
        anchors.top: sectionAutoHeal.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        height: 120

        KuroBotSectionTitle
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          text: Friend Healing Helper

        Label
          id: friendSelectLabel
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 6
          margin-left: 4
          text: Select a Friend
          color: #d4d4d8
          font: verdana-11px-rounded

        KuroBotInfoButton
          anchors.verticalCenter: friendSelectLabel.verticalCenter
          anchors.left: friendSelectLabel.right
          margin-left: 4

        KuroBotListPanel
          id: friendList
          anchors.top: friendSelectLabel.bottom
          anchors.left: parent.left
          anchors.bottom: parent.bottom
          width: 140
          margin-top: 4
          margin-left: 4
          margin-bottom: 4

        Label
          anchors.top: friendSelectLabel.top
          anchors.left: friendList.right
          margin-left: 10
          text: Heal Friend List
          color: #d4d4d8
          font: verdana-11px-rounded

        KuroBotAddButton
          id: addFriend1
          anchors.top: prev.bottom
          anchors.left: friendList.right
          margin-left: 10
          margin-top: 6

        KuroBotCheckBox
          id: sio1Enable
          anchors.verticalCenter: addFriend1.verticalCenter
          anchors.left: addFriend1.right
          margin-left: 6
          text: Enable Sio

        KuroBotSpinBox
          id: sio1Pct
          anchors.verticalCenter: addFriend1.verticalCenter
          anchors.left: prev.right
          margin-left: 6

        KuroBotInfoButton
          anchors.verticalCenter: addFriend1.verticalCenter
          anchors.left: prev.right
          margin-left: 4

        KuroBotAddButton
          id: addFriend2
          anchors.top: addFriend1.bottom
          anchors.left: friendList.right
          margin-left: 10
          margin-top: 4

        KuroBotCheckBox
          id: sio2Enable
          anchors.verticalCenter: addFriend2.verticalCenter
          anchors.left: addFriend2.right
          margin-left: 6
          text: Enable Sio

        KuroBotSpinBox
          id: sio2Pct
          anchors.verticalCenter: addFriend2.verticalCenter
          anchors.left: prev.right
          margin-left: 6

        KuroBotInfoButton
          anchors.verticalCenter: addFriend2.verticalCenter
          anchors.left: prev.right
          margin-left: 4

      // ── Exura Gran Sio Helper ────────────
      KuroBotSection
        id: sectionExura
        anchors.top: sectionFriendHeal.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        height: 100

        KuroBotSectionTitle
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          text: Exura Gran Sio Helper

        Label
          id: exuraSelectLabel
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 6
          margin-left: 4
          text: Select a Friend
          color: #d4d4d8
          font: verdana-11px-rounded

        KuroBotInfoButton
          anchors.verticalCenter: exuraSelectLabel.verticalCenter
          anchors.left: exuraSelectLabel.right
          margin-left: 4

        KuroBotListPanel
          id: exuraFriendList
          anchors.top: exuraSelectLabel.bottom
          anchors.left: parent.left
          anchors.bottom: parent.bottom
          width: 140
          margin-top: 4
          margin-left: 4
          margin-bottom: 4

        Label
          anchors.top: exuraSelectLabel.top
          anchors.left: exuraFriendList.right
          margin-left: 10
          text: Heal Friend List
          color: #d4d4d8
          font: verdana-11px-rounded

        KuroBotAddButton
          id: addExura1
          anchors.top: prev.bottom
          anchors.left: exuraFriendList.right
          margin-left: 10
          margin-top: 6

        KuroBotCheckBox
          id: exura1Enable
          anchors.verticalCenter: addExura1.verticalCenter
          anchors.left: addExura1.right
          margin-left: 6
          text: Enable

        KuroBotSpinBox
          id: exura1Pct
          anchors.verticalCenter: addExura1.verticalCenter
          anchors.left: prev.right
          margin-left: 6

        KuroBotInfoButton
          anchors.verticalCenter: addExura1.verticalCenter
          anchors.left: prev.right
          margin-left: 4

    // ╔══════════════════════════════════╗
    // ║            TOOLS TAB             ║
    // ╚══════════════════════════════════╝
    Panel
      id: tabTools
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 200
      visible: false

      KuroBotSection
        id: sectionToolsHelper
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 188

        KuroBotSectionTitle
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          text: Tools Helper

        // Row 1 left: Mana Training
        Label
          id: manaTitle
          anchors.top: prev.bottom
          anchors.left: parent.left
          margin-top: 6
          margin-left: 4
          color: #d4d4d8
          font: verdana-11px-rounded
          text: Mana Training

        KuroBotIconSlot
          id: manaIcon
          anchors.top: manaTitle.bottom
          anchors.left: parent.left
          margin-top: 4
          margin-left: 4
          image-source: /images/icons/mana_training.png

        KuroBotCheckBox
          id: manaEnable
          anchors.top: manaIcon.top
          anchors.left: manaIcon.right
          margin-left: 8
          text: Enable

        KuroBotSpinBox
          id: manaPct
          anchors.top: manaEnable.bottom
          anchors.left: manaIcon.right
          margin-left: 8
          margin-top: 4

        KuroBotInfoButton
          anchors.verticalCenter: manaPct.verticalCenter
          anchors.left: manaPct.right
          margin-left: 4

        // Row 1 right: Auto Haste
        Label
          id: hasteTitle
          anchors.top: manaTitle.top
          anchors.right: parent.right
          margin-right: 4
          color: #d4d4d8
          font: verdana-11px-rounded
          text: Auto Haste

        KuroBotIconSlot
          id: hasteIcon
          anchors.top: hasteTitle.bottom
          anchors.right: parent.right
          margin-top: 4
          margin-right: 4
          image-source: /images/icons/auto_haste.png

        KuroBotCheckBox
          id: hasteEnable
          anchors.top: hasteIcon.top
          anchors.right: hasteIcon.left
          margin-right: 8
          text: Enable

        KuroBotCheckBox
          id: hastePZCast
          anchors.top: hasteEnable.bottom
          anchors.right: hasteIcon.left
          margin-right: 8
          margin-top: 4
          text: PZ Cast

        // Row 2 left: Exercise Training
        Label
          id: exerciseTitle
          anchors.top: manaIcon.bottom
          anchors.left: parent.left
          margin-top: 14
          margin-left: 4
          color: #d4d4d8
          font: verdana-11px-rounded
          text: Exercise Training

        KuroBotIconSlot
          id: exerciseIcon
          anchors.top: exerciseTitle.bottom
          anchors.left: parent.left
          margin-top: 4
          margin-left: 4
          image-source: /images/icons/exercise_weapon.png

        KuroBotCheckBox
          id: exerciseEnable
          anchors.top: exerciseIcon.top
          anchors.left: exerciseIcon.right
          margin-left: 8
          text: Enable

        KuroBotComboBox
          id: exerciseSelect
          anchors.top: exerciseEnable.bottom
          anchors.left: exerciseIcon.right
          margin-left: 8
          margin-top: 4
          width: 90

        KuroBotInfoButton
          anchors.verticalCenter: exerciseSelect.verticalCenter
          anchors.left: exerciseSelect.right
          margin-left: 4

        // Row 2 right: Others Tools
        Label
          id: othersTitle
          anchors.top: exerciseTitle.top
          anchors.right: parent.right
          margin-right: 4
          color: #d4d4d8
          font: verdana-11px-rounded
          text: Others Tools

        KuroBotInfoButton
          anchors.verticalCenter: othersTitle.verticalCenter
          anchors.left: othersTitle.right
          margin-left: 4

        KuroBotCheckBox
          id: changeGold
          anchors.top: othersTitle.bottom
          anchors.right: parent.right
          margin-right: 4
          margin-top: 6
          text: Change Gold
          checked: true

        KuroBotCheckBox
          id: autoEatFood
          anchors.top: changeGold.bottom
          anchors.right: parent.right
          margin-right: 4
          margin-top: 4
          text: Auto Eat Food
          checked: true

        KuroBotCheckBox
          id: autoReconnect
          anchors.top: autoEatFood.bottom
          anchors.right: parent.right
          margin-right: 4
          margin-top: 4
          text: Auto Reconnect

    // ╔══════════════════════════════════╗
    // ║          SKILL SET TAB           ║
    // ╚══════════════════════════════════╝
    Panel
      id: tabSkillSet
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 200
      visible: false

      Label
        anchors.centerIn: parent
        text: Skill Set — Coming Soon
        color: #52525b
        font: verdana-11px-rounded

    // ╔══════════════════════════════════╗
    // ║           HUNTING TAB            ║
    // ╚══════════════════════════════════╝
    Panel
      id: tabHunting
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 200
      visible: false

      Label
        anchors.centerIn: parent
        text: Hunting — Coming Soon
        color: #52525b
        font: verdana-11px-rounded

  // ── FOOTER ──────────────────────────────────────────────
  Panel
    id: footer
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    background-color: #3a3a42
    border-width: 1
    border-color: #52525b

    Label
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 8
      color: #d4d4d8
      font: verdana-11px-rounded
      text: Helper Status:

    Label
      id: statusValue
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: prev.right
      margin-left: 4
      color: #4ade80
      font: verdana-11px-rounded
      text: Enabled

    UIWidget
      id: statusDot
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: prev.right
      margin-left: 4
      size: 8 8
      background-color: #4ade80

    KuroBotButton
      id: setKeyBtn
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: prev.right
      margin-left: 8
      text: Set Key
      width: 54

    KuroBotButton
      id: helperStatsBtn
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: closeBtn.left
      margin-right: 4
      text: Helper Stats
      width: 76

    KuroBotButton
      id: closeBtn
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      margin-right: 8
      text: Close
      width: 48
      @onClick: modules.game_kurobot.toggle()
